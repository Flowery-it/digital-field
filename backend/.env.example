# 环境变量模板：复制为 .env 并填入真实值（.env 永不入库、不进交付包）
#   cp backend/.env.example backend/.env

# 数据库配置（DB_DIALECT=mysql 时生效；sqlite 模式无需安装数据库）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crop_data

# 数据库方言：sqlite（本地演示，无需安装 MySQL）/ mysql（容器与生产环境）
DB_DIALECT=sqlite

# JWT配置（必须改为 32 位以上随机串，例如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=
JWT_EXPIRES_IN=2h

# 和风天气 API Key（天气页面用，https://dev.qweather.com/ 申请；商用需付费套餐）
QWEATHER_API_KEY=

# 天气服务端缓存小时数（方案要求 3-6 小时）
WEATHER_CACHE_TTL_HOURS=4

# ===== AI 增强层（可选）=====
# 不配置时，AI 农事问答自动使用本地 34 条农事规则引擎作答，功能不中断。
# AI_PROVIDER 可选：intern（书生·浦语多模型网关）/ doubao（火山方舟）/ deepseek / qwen（百炼）/ ollama（本地）/ openai
#
# 免费接入方式（任选其一）：
#   1) 书生·浦语 discovery-api 网关：一个 Key 打通 intern-s2、deepseek-v4、qwen3.8、glm-5.3、kimi 等模型
#   2) DeepSeek   —— https://platform.deepseek.com 注册即赠免费额度，模型填 deepseek-chat
#   3) 豆包火山方舟 —— https://console.volcengine.com/ark 创建应用，模型填控制台的推理接入点 ID（ep-...）
#   4) 通义千问    —— https://bailian.console.aliyun.com 新用户赠免费 token，模型填 qwen-plus
#   5) Ollama 本地 —— 完全免费、无需 Key、离线可用：
#        ollama pull qwen2.5:1.5b-instruct && ollama serve
#        AI_PROVIDER=ollama / AI_MODEL=qwen2.5:1.5b-instruct / AI_API_KEY 留空
#
# ⚠️ 推理型模型（intern-s2 / kimi 等带思维链的模型）：输出预算会被 reasoning tokens 大量占用
#    （实测 2200—3400 tokens），单模型所需的 max_tokens / 超时已在
#    backend/services/llmService.js 的 INTERN_MODELS 中按实测标定，切换模型时自动生效，
#    无需手动调这两个参数。只有新增自定义模型时才需要参考：
#    非推理模型 2000 / 60000；推理模型 12000 / 180000。
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_FALLBACK_MODELS=
AI_ALLOWED_MODELS=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2000
AI_FALLBACK_TIMEOUT_MS=30000

# 可选：覆盖默认账号口令（不填则 admin/admin123、demo/demo123）
# ADMIN_DEFAULT_PASSWORD=
# DEMO_DEFAULT_PASSWORD=
